            "description": "Requiere el usuario CLIENTE creado en el paso 01. Con ADMINISTRADOR la respuesta correcta es 200.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
